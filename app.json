{
  "expo": {
    "name": "PaytmX",
    "slug": "paytmx",
    "scheme": "paytmx",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android", "web"],
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      ["expo-router"],
      ["react-native-reanimated"],
      ["expo-barcode-scanner"],
      ["expo-secure-store"]
    ]
  }
}